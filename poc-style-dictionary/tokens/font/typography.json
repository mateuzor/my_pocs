{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "system-ui, sans-serif" },
      "mono": { "$value": "ui-monospace, monospace" }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.5rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    }
  }
}
