{
  // Main and preload run in Node/Electron: CommonJS output is required
  // (sandboxed preload scripts cannot be ES modules).
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/main", "src/preload", "src/shared"]
}
