{
  "name": "poc-bundle-analyzer",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "analyze": "ANALYZE=true webpack --mode production",
    "analyze:slim": "ANALYZE=true webpack --mode production --env slim",
    "stats": "webpack --mode production --profile --json > stats.json && webpack-bundle-analyzer stats.json dist"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "html-webpack-plugin": "^5.6.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.92.0",
    "webpack-bundle-analyzer": "^4.10.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.0.0"
  }
}
